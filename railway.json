{
  "$schema": "https://railway.app/railway.schema.json",
  "build": {
    "builder": "NIXPACKS",
    "buildCommand": "pip install -r server/requirements.txt"
  },
  "deploy": {
    "startCommand": "cd server && gunicorn app:app --host 0.0.0.0 --port $PORT --timeout 30 --workers 1",
    "healthcheckPath": "/api/face/status",
    "healthcheckTimeout": 100
  }
}
